generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model ServerStatus {
  id               String   @id @default(uuid())
  serverName       String   @unique
  grupo            String?
  ambiente         String?
  domain           String?
  ip               String?
  os               String?
  osVersion        String?
  analista         String?
  sqlInstancia     String?
  sqlVersion       String?
  sqlUltimaActualizacion String?
  fechaVentana     String?
  installDate      String?
  installedKBs     String?
  rebootDate       String?
  runningTime      String?
  diskSpace        String?
  errorDescription String?
  comentarios      String?
  snap             String?
  confirmado       String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model SyncRun {
  id       String        @id @default(uuid())
  syncedAt DateTime      @default(now())
  total    Int           @default(0)
  success  Int           @default(0)
  errors   Int           @default(0)
  noData   Int           @default(0)
  isNew    Boolean       @default(true)
  records  SyncHistory[]
}

model SyncHistory {
  id               String   @id @default(uuid())
  syncRunId        String
  syncRun          SyncRun  @relation(fields: [syncRunId], references: [id])
  serverName       String
  grupo            String?
  ambiente         String?
  domain           String?
  ip               String?
  os               String?
  osVersion        String?
  analista         String?
  sqlInstancia     String?
  sqlVersion       String?
  sqlUltimaActualizacion String?
  fechaVentana     String?
  installDate      String?
  installedKBs     String?
  rebootDate       String?
  runningTime      String?
  diskSpace        String?
  errorDescription String?
  comentarios      String?
  snap             String?
  confirmado       String?
  status           String
  createdAt        DateTime @default(now())

  @@index([syncRunId])
  @@index([serverName])
  @@index([status])
}

model JiraTicket {
  id               String   @id @default(uuid())
  ticketKey        String   @unique
  ticketUrl        String
  bank             String
  errorDescription String
  creatorUsername  String?
  assignedUsername String?
  reporterName     String?
  isUnread         Boolean  @default(false)
  reassignedBy     String?
  createdAt        DateTime @default(now())

  @@index([bank, errorDescription])
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  password           String
  role               String    @default("user")
  fullName           String?
  email              String?
  isConfirmed        Boolean   @default(false)
  mustChangePassword Boolean   @default(true)
  passwordExpiry     DateTime?
  createdAt          DateTime  @default(now())
}

model MonthlyServerStatus {
  id               String   @id @default(uuid())
  month            String   // Format: YYYY-MM
  serverName       String
  grupo            String?
  ambiente         String?
  domain           String?
  ip               String?
  os               String?
  osVersion        String?
  analista         String?
  sqlInstancia     String?
  sqlVersion       String?
  sqlUltimaActualizacion String?
  fechaVentana     String?
  installDate      String?
  installedKBs     String?
  rebootDate       String?
  runningTime      String?
  diskSpace        String?
  errorDescription String?
  comentarios      String?
  snap             String?
  confirmado       String?
  status           String
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([month, serverName])
  @@index([month])
  @@index([serverName])
}

model PatchOrder {
  id            String   @id @default(uuid())
  title         String
  description   String?
  actionType    String   // 'CHECK' or 'INSTALL'
  targetGroups  String?  // e.g., 'ASJ, BSC'
  targetServers String?  // e.g., 'SRV1, SRV2'
  scheduledAt   DateTime // When it should be executed
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  executionLog  String?  @db.Text
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

